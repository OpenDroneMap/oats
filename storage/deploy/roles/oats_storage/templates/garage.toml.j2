# Managed by Ansible; local edits are overwritten.
metadata_dir = "{{ oats_data_root }}/meta"
data_dir = "{{ oats_data_root }}/data"
db_engine = "sqlite"

replication_factor = 1

rpc_secret_file = "{{ oats_conf_dir }}/rpc_secret"

rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"

# CI publishes to the S3 API; the reverse proxy fronts the web endpoint.
[s3_api]
s3_region = "garage"
api_bind_addr = "{{ oats_bind_addr }}:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "{{ oats_bind_addr }}:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token_file = "{{ oats_conf_dir }}/admin_token"
