# Copy to storage/.env and fill in. storage/.env is git-ignored; never commit it.
#
# Generate fresh secrets with:
#   GARAGE_RPC_SECRET   -> openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN  -> openssl rand -base64 32

# Shared secret authenticating RPC between Garage nodes (required even single-node).
GARAGE_RPC_SECRET=

# Bearer token for the Garage admin API on :3903.
GARAGE_ADMIN_TOKEN=
